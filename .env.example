# Twilio credentials — get these from console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp sandbox number (format: +14155238886 for sandbox)
TWILIO_WHATSAPP_FROM=+14155238886

# Your personal WhatsApp number (with country code, e.g. +16041234567)
YOUR_WHATSAPP_NUMBER=+1XXXXXXXXXX

# Server port (default 3000)
PORT=3000
